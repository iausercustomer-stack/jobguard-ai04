# JobGuard AI Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values before running in production.
# NEVER commit a real .env file containing secrets to version control.

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-jobguard-frontend.vercel.app

# Input validation & rate limiting
MAX_INPUT_CHARS=12000
RATE_LIMIT_PER_MINUTE=30

# Supabase Configuration (uses anon public key + forwarded user JWT to preserve Row Level Security)
# NEVER put a Supabase service_role key here or in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-placeholder
SUPABASE_TIMEOUT_SECONDS=8.0

# Optional OpenAI-Compatible AI Explanation Layer (Server-Side Only)
# The deterministic rule-based analyzer always works even when AI_ENABLED=false.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-server-side-ai-api-key-placeholder
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=12.0
AI_MAX_TOKENS=500

# Optional Heuristic Category Threshold Overrides (0-100 scale)
THRESHOLD_MODERATE=20
THRESHOLD_HIGH=45
THRESHOLD_VERY_HIGH=70
